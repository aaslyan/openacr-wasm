ui.key_map  key_map:global.3       p_widget:""       key:3       action:activate
ui.key_map  key_map:browser.j      p_widget:browser  key:j       action:navigate_next
ui.key_map  key_map:browser.k      p_widget:browser  key:k       action:navigate_prev
ui.key_map  key_map:browser.down   p_widget:browser  key:Down    action:navigate_next
ui.key_map  key_map:browser.up     p_widget:browser  key:Up      action:navigate_prev
