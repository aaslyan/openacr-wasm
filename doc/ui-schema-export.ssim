dmmeta.field  field:uimsg.ExpandMsg.widget       arg:algo.Smallstr50   reftype:Val     dflt:""  comment:"Tree widget"
dmmeta.field  field:uimsg.ExpandMsg.node_key     arg:algo.Smallstr50   reftype:Val     dflt:""  comment:"Node to expand/collapse"
dmmeta.field  field:uimsg.ExpandMsg.expand       arg:bool              reftype:Val     dflt:""  comment:"true=expand false=collapse"
dmmeta.field  field:uimsg.FocusMsg.base          arg:uimsg.MsgHeader   reftype:Base    dflt:""  comment:""
dmmeta.field  field:uimsg.FocusMsg.widget        arg:algo.Smallstr50   reftype:Val     dflt:""  comment:"Widget to focus"
dmmeta.field  field:uimsg.InsertMsg.base         arg:uimsg.MsgHeader   reftype:Base    dflt:""  comment:""
dmmeta.field  field:uimsg.InsertMsg.ssim         arg:char              reftype:Varlen  dflt:""  comment:"Ssim tuple to insert"
dmmeta.field  field:uimsg.KeyPressMsg.base       arg:uimsg.MsgHeader   reftype:Base    dflt:""  comment:""
dmmeta.field  field:uimsg.KeyPressMsg.key        arg:u8                reftype:Val     dflt:""  comment:"Key code"
dmmeta.field  field:uimsg.KeyPressMsg.modifiers  arg:u8                reftype:Val     dflt:""  comment:"Modifier flags (shift/ctrl/alt)"
dmmeta.field  field:uimsg.MsgHeader.type         arg:u32               reftype:Val     dflt:""  comment:"Message type id"
dmmeta.field  field:uimsg.MsgHeader.length       arg:u32               reftype:Val     dflt:""  comment:"Message length in bytes"
dmmeta.field  field:uimsg.NavigateMsg.base       arg:uimsg.MsgHeader   reftype:Base    dflt:""  comment:""
dmmeta.field  field:uimsg.NavigateMsg.widget     arg:algo.Smallstr50   reftype:Val     dflt:""  comment:"Target widget"
dmmeta.field  field:uimsg.NavigateMsg.direction  arg:i8                reftype:Val     dflt:""  comment:"1=next -1=prev"

dmmeta.field  field:uimsg.QuitMsg.base       arg:uimsg.MsgHeader  reftype:Base  dflt:""  comment:""
dmmeta.field  field:uimsg.RefreshMsg.base    arg:uimsg.MsgHeader  reftype:Base  dflt:""  comment:""
dmmeta.field  field:uimsg.ScrollMsg.base     arg:uimsg.MsgHeader  reftype:Base  dflt:""  comment:""
dmmeta.field  field:uimsg.ScrollMsg.widget   arg:algo.Smallstr50  reftype:Val   dflt:""  comment:"Widget to scroll"
dmmeta.field  field:uimsg.ScrollMsg.delta    arg:i32              reftype:Val   dflt:""  comment:"Scroll amount (positive=down)"
dmmeta.field  field:uimsg.SelectMsg.base     arg:uimsg.MsgHeader  reftype:Base  dflt:""  comment:""
dmmeta.field  field:uimsg.SelectMsg.widget   arg:algo.Smallstr50  reftype:Val   dflt:""  comment:Widget
dmmeta.field  field:uimsg.SelectMsg.row_key  arg:algo.Smallstr50  reftype:Val   dflt:""  comment:"Selected row key"

